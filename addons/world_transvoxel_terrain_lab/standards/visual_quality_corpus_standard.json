{
	"schema": "world_transvoxel.terrain_lab.visual_quality_corpus_standard.v1",
	"milestone": "TQP-25",
	"standard_id": "reference_visual_quality_corpus_v1",
	"review_scene": "res://labs/terrain_lab/scenes/visual_quality_review.tscn",
	"draft_path": "user://tqp25_visual_quality_review_draft.json",
	"automated_evidence": "res://labs/terrain_lab/results/visual_quality_corpus_reference_windows.json",
	"formal_decision_required": true,
	"native_dependency_only": true,
	"capture_contract": {
		"width": 1280,
		"height": 720,
		"motion_frame_count": 48,
		"motion_fps": 24,
		"repeatability_passes": 2,
		"minimum_unique_motion_frames": 40,
		"video_codec": "h264",
		"video_pixel_format": "yuv420p"
	},
	"criteria": [
		{
			"id": "natural_forms_coherent",
			"label": "Natural forms remain coherent",
			"failure": "Natural slopes, cuts, or undercuts read as accidental faceting, cracks, or detached shading."
		},
		{
			"id": "construction_legible",
			"label": "Construction remains legible",
			"failure": "Authored platforms, walls, spans, supports, or openings lose their intended shape or material boundary."
		},
		{
			"id": "destruction_coherent",
			"label": "Destruction remains coherent",
			"failure": "Overlapping craters, tunnels, or damaged construction produce unexplained holes, sheets, or disconnected fragments."
		},
		{
			"id": "adversarial_behavior_bounded",
			"label": "Adversarial behavior is bounded",
			"failure": "Thin, tangent, noisy, or overlapping features fail outside the limits declared by the resolution standard."
		},
		{
			"id": "materials_and_shading_stable",
			"label": "Materials and shading remain attached",
			"failure": "Texture projection, normals, masks, or material identity slide, pop, invert, or expose a chunk boundary during motion."
		},
		{
			"id": "shadow_quality_acceptable",
			"label": "Shadow behavior is acceptable at declared resolution",
			"failure": "Cast shadows slide, pop, change topology, or remain unacceptably stepped on the 0.25 m adversarial reference fixture."
		},
		{
			"id": "no_unclassified_visual_defect",
			"label": "No visual defect remains unclassified",
			"failure": "A visible inconsistency is accepted without an identified cause, bounded scope, and retained finding."
		}
	],
	"decision_policy": {
		"all_fixtures_must_be_visited": true,
		"all_fixtures_require_one_motion_cycle": true,
		"adversarial_requires_shadow_on_off_comparison": true,
		"all_criteria_required_for_candidate_acceptance": true,
		"uncertain_review_is_pending": true,
		"draft_cannot_promote_milestone": true,
		"repository_decision_required_for_promotion": true,
		"tqp_f001_closes_only_with_explicit_shadow_decision": true
	},
	"finite_window_boundary_policy": {
		"operations_must_not_intersect_the_declared_window_exterior": true,
		"exterior_open_edges_are_expected_only_on_window_planes": true,
		"views_through_an_uncapped_window_exterior_are_not_interior_terrain_holes": true,
		"interior_open_edges_or_nonmanifold_edges_always_fail": true
	},
